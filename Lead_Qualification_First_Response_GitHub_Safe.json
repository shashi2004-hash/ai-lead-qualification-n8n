    {
      "parameters": {
        "jsCode": "const raw = $('Build Claude Request').item.json.raw_payload;\nconst resp = $input.first().json;\n\nlet text = '';\ntry {\n text = resp.candidates[0].content.parts[0].text;\n} catch (e) {\n  throw new Error('Claude response missing content: ' + JSON.stringify(resp));\n}\n\n// strip stray code fences just in case\ntext = text.trim().replace(/^```json/, '').replace(/^```/, '').replace(/```$/, '').trim();\n\nlet data;\ntry {\n  data = JSON.parse(text);\n} catch (e) {\n  throw new Error('Could not parse Claude JSON: ' + text);\n}\n\nconst required = ['reasoning','score','confidence','industry','pain_point','budget_tier','urgent','route','reply_email','crm_notes'];\nfor (const f of required) {\n  if (!(f in data)) throw new Error('Missing field \"' + f + '\" in Claude response: ' + text);\n}\n\n// Safety override: never let a low-confidence call auto-send.\n// This is the one rule the workflow enforces in code, not just in the prompt.\nif (data.confidence === 'low' && data.route === 'auto_reply') {\n  data.route = 'human_review';\n  data.crm_notes += ' [auto-routed to human review: low confidence]';\n}\n\ndata.raw_payload = raw;\ndata.route_debug = JSON.stringify(data.route) + ' | length: ' + data.route.length;\nreturn [{ json: data }];"
      },
